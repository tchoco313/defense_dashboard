# 접속 정보 틀 — 이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채운다.
#   cp .env.example .env        (윈도우: copy .env.example .env)
# .env 는 .gitignore 에 있어서 깃에 안 올라간다. 비밀번호는 채팅·문서·커밋에 남기지 않는다.
# 읽는 곳은 scripts/dbconf.py 한 곳이다. 설명은 docs/runbook/db-connection.md

# ── 방법 1. 로컬 MySQL — 제출 패키지의 DB 덤프를 복원한 경우(검사 · 시연용) ──
#   덤프 복원 방법은 db/README.md. 아래 비밀번호는 내 PC MySQL 의 계정 비밀번호(없으면 빈칸).
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=
MARIADB_DATABASE=defense_dashboard
MARIADB_SSL=0

# ── 방법 2. 팀 DB (AWS RDS, MySQL 8.4) — 팀원용. 쓰려면 위 6줄을 지우고 아래 # 을 뗀다 ──
#   접속 정보는 DB 관리자에게 받는다(허용된 IP 에서만 접속된다).
# MARIADB_HOST=<RDS_ENDPOINT>
# MARIADB_PORT=3306
# MARIADB_USER=<계정>
# MARIADB_PASSWORD=<비밀번호>
# MARIADB_DATABASE=defense_dashboard
# MARIADB_SSL=1

# ── 공공데이터포털 인증키 (수집 스크립트 · 관세청 원천 확인에만 필요) ──
DATA_GO_KR_SERVICE_KEY=
