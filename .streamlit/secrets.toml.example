# Streamlit Community Cloud → 앱 설정(⋮ → Settings) → Secrets 에 이 내용을 채워 붙여 넣는다(파일은 커밋하지 않음).
# 계정은 SELECT 전용 app_ro 만 넣는다 — 마스터(admin)·적재용(etl_rw)은 넣지 않는다.
# 로컬에서는 .env 를 쓰므로 이 파일이 필요 없다. scripts/rds_accounts.py 가 실제 값이 든 secrets.toml 을 만든다(gitignore).
MARIADB_HOST = "<RDS 엔드포인트>"
MARIADB_PORT = "3306"
MARIADB_USER = "app_ro"
MARIADB_PASSWORD = "<app_ro 비밀번호>"
MARIADB_DATABASE = "defense_dashboard"
MARIADB_SSL = "1"
# 관세청 원천 최신 월 확인(dashboard/live.py) — 공공데이터포털 인증키(15100475 활용신청 계정, 로컬 .env 의 같은 이름 값). 없으면 그 한 줄만 「원천 확인 꺼짐」.
DATA_GO_KR_SERVICE_KEY = "<공공데이터포털 인증키>"
